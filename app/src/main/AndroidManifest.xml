<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Optional: lets Settings change Android's screen timeout. Granted by the user in Settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- usesCleartextTraffic: HA is plain http on the LAN. Without it, targetSdk 28+ blocks http:// and ws://. -->
    <application
        android:name=".HostApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Harmonium Host"
        android:theme="@style/Theme.HarmoniumHost"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Uncomment once it's stable so it replaces Fully Kiosk as the remote's home screen
                 (it then also comes back by itself after a reboot). -->
            <!--
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            -->
        </activity>

        <!-- Also in the app drawer as "Harmonium settings", so it's reachable without adb. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Harmonium settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HostService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
